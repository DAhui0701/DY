# 本地真实报表与经营数据。需要保存时，优先使用下列目录。
/reports/
/data/
/local-data/
/uploads/
/exports/
/private/

# 常见报表、数据库、备份文件（任何目录均忽略）
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.xlsb
*.ods
*.db
*.sqlite
*.sqlite3
*.sql
*.parquet
*.jsonl
*.bak
*.zip
*.7z

# 密钥与本地配置。不要把真实值写入页面代码。
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
*.local
*.local.*

# 编辑器、系统及运行临时文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
__pycache__/
node_modules/

# 上传附件及可能包含经营数据的验收输出
/attachments/
/test-results/
/playwright-report/
/screenshots/
